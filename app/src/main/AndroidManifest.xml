<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Live Wallpaper Service -->
        <service
            android:name=".SuperWallpaperService"
            android:label="Super Wallpaper"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            
            <!-- Links the wallpaper metadata (Step 1 file) to enable the gear icon -->
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- Wallpaper Settings Activity -->
        <activity
            android:name=".WallpaperSettingsActivity"
            android:label="Wallpaper Settings"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Settings" />

    </application>

</manifest>
